# deploy/.env.preview.example —— preview 环境密钥注入模板
#
# 复制为 deploy/.env.preview 并**填入真实的服务器机密**。本文件不含任何可用密钥，
# 仅列必需项与说明，让"移除演示密码、改由服务器环境密钥注入"落到可执行的注入清单上。
# deploy/.env.preview 已加入 .gitignore，不得提交。
#
# 重要：以下任一项缺省为空 / 仍为占位符 / 命中被禁默认值时，受控相关服务会启动失败
# （fail-closed），不会带病对外服务：
#   - POSTGRES_PASSWORD / REDIS_PASSWORD / APP_RUNTIME_PASSWORD 为空 → postgres/redis 启动即被拒。
#   - AUTH_JWT_SECRET 为空 且 ENV=preview → api 启动即 fail-closed（见 src/main.py）。
#   - EXECUTION_CALLBACK_HMAC_SECRET 为空或为内建默认 `shadow-callback-secret` → check_secrets 拒绝。
#   - HIGH_CONFIDENCE_MODELS / LLM_ALLOWED_HOSTS / LAUNCH_ALLOWED_TENANTS 为空 → 写操作/端点/租户门控 fail-closed。
#   - LAUNCH_GATE_STRICT 非 true → 受限环境严格门控未开启，check_secrets 拒绝。
#
# 用法：
#   cp deploy/.env.preview.example deploy/.env.preview   # 然后逐项替换
#   docker compose --env-file deploy/.env.preview -f docker-compose.preview.yml up -d

# ---- 运行态 ----
ENV=preview
STORAGE_BACKEND=postgres
LOG_LEVEL=INFO

# ---- PostgreSQL（owner/迁移角色，具备 CREATE/ALTER/CREATEROLE）----
POSTGRES_USER=migrator
POSTGRES_PASSWORD=<inject>
POSTGRES_DB=langgraph

# ---- 运行角色（app_runtime，仅 DML，LOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS）----
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=<inject>

# ---- 最小权限备份角色（backup_role，仅 CONNECT/SELECT，BYPASSRLS 以读出全量；绝无写/DDL）----
# migrate 一次性服务用 BACKUP_ROLE_PASSWORD 创建/更新该角色；backup sidecar / backup_encrypted.sh 用它连库。
BACKUP_ROLE_USER=backup_role
BACKUP_ROLE_PASSWORD=<inject>
# 备份对称加密密钥（aes-256-cbc + PBKDF2）。由服务器环境注入，**绝不硬编码/打印/写日志**；
# 生成：openssl rand -base64 32。缺失则 check_secrets 拒绝部署（见 deploy/DR_KEY_MANAGEMENT.md）。
BACKUP_ENC_KEY=<inject>
# 备份保留份数（缺省 8）与周期（缺省 900s=15min）。异机副本可选（见 compose backup 服务）。
BACKUP_KEEP=8
BACKUP_INTERVAL_SECONDS=900
# 异机副本（可选，受控路径）：受控归档目录（宿主机代码库之外）与 rsync/scp 目标。
# 缺省由 compose 用 ./data/preview-backups-offsite 作演示；生产应改为宿主机代码库之外的真实受控目录/异机。
BACKUP_REMOTE_DIR=/offsite
BACKUP_RSYNC_DEST=

# ---- Redis（requirepass）----
REDIS_PASSWORD=<inject>

# ---- 认证（真实 JWT，HS256；preview 必须提供，缺失则 api 启动失败）----
AUTH_JWT_SECRET=<inject>
AUTH_JWT_ISSUER=after-sales
AUTH_JWT_AUDIENCE=after-sales-web
# 固定令牌过期（秒）：签发 exp = iat + 该值；预发布建议按会话时长设定（默认 3600）。
AUTH_JWT_TTL_SECONDS=3600
# 当前签名密钥的 kid；留空则自动 = sha256(AUTH_JWT_SECRET)[:16]。
AUTH_JWT_KID=
# 密钥轮换池：上一代密钥（逗号分隔）。仅用于校验旧令牌（宽容窗口），绝不用于新签发。
# 轮换：新密钥写入 AUTH_JWT_SECRET，旧密钥追加到此处；超过 TTL 且无旧令牌校验失败后从列表移除。
AUTH_JWT_ROTATED_SECRETS=
# 登录端点凭据表（JSON）：{"<tenant_id>:<user_id>": "<PHC 哈希（argon2id|bcrypt）>"}（由服务器注入）。
# 生成：python scripts/hash_login_credentials.py --algorithm argon2id|bcrypt（输出仅 PHC 哈希，绝不明文）。
# 用于 POST /api/auth/login 签发真实 JWT；未配置时登录 fail-closed（503）。
AUTH_LOGIN_CREDENTIALS=<inject-json>
# 登录凭据哈希算法：argon2id（默认，推荐）| bcrypt。仅允许这两者；禁止无盐 SHA-256/md5（弱哈希）。
AUTH_CREDENTIAL_HASH=argon2id

# ---- 登录限流与失败退避（双维度：账号 + IP）----
# 存储后端：memory（单进程/无状态，默认）| redis（分布式；需 REDIS_URL）。
LOGIN_RATE_LIMIT_STORE=memory
# 限流窗口（秒）；账号维度与 IP 维度共用。
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# 单账号窗口内最大登录尝试次数；超限拒绝并审计（login_rate_limited）。
LOGIN_ACCOUNT_RATE_LIMIT=5
# 单 IP 窗口内最大登录尝试次数（跨账号聚合）；超限拒绝并审计（ip_rate_limited）。
LOGIN_IP_RATE_LIMIT=30
# 失败退避：同账号连续失败达 LOGIN_BACKOFF_MAX_FAILURES 次后锁定一段时间（指数 + 封顶）。
LOGIN_BACKOFF_MAX_FAILURES=5
LOGIN_BACKOFF_BASE_SECONDS=1.0
LOGIN_BACKOFF_MAX_SECONDS=900
# 受信任反向代理头来源数（nginx 之后取最后一个可信 X-Forwarded-For 作为客户端 IP）。
LOGIN_TRUSTED_PROXY_DEPTH=1

# ---- 首批上线租户 + 首次上线严格门控 ----
# 受限环境强制开启 LAUNCH_GATE_STRICT=true；首批上线只能放行少量租户，否则 verify_launch_gate --strict 失败。
LAUNCH_GATE_STRICT=true
LAUNCH_REQUIRE_APPROVAL=true
LAUNCH_FULL_AUDIT=true
LAUNCH_MANUAL_REVIEW=true
# 首批上线租户白名单（逗号分隔，非空；所有会话/审批/操作仅限这些租户，其它拒绝并审计）。
# 安全基线：preview/production **一律禁用 seed_default**（DEMO_SEED_ENABLED=false，见下），
# 首批真实租户与成员必须由受控迁移/运维脚本创建（如 scripts/create_bootstrapped_tenants.py），
# 再用 `hash_login_credentials.py` 为其成员生成 argon2id/bcrypt PHC 填入 AUTH_LOGIN_CREDENTIALS。
# 如需演示租户仅用于本地开发/测试（development/test 才允许 DEMO_SEED_ENABLED=true）。
# 格式示例：LAUNCH_ALLOWED_TENANTS=TENANT-A,TENANT-B
LAUNCH_ALLOWED_TENANTS=<inject-first-batch-tenants>

# ---- 演示/种子数据（安全基线）----
# 仅 development/test 且为 true 才允许 seed_default（src/main.py::seed_default 预置演示租户/成员）；
# preview/production 必须为 false（受限环境无论本值如何都拒绝，见 src/config.py is_restricted_env）。
DEMO_SEED_ENABLED=false

# ---- 发布记录所需：环境/配置版本（配置漂移审计）----
# 随部署基线递增；写入 PRODUCTION_DEPLOYMENT_record-*.md 的 DEPLOY_CONFIG_VERSION 字段。
DEPLOY_CONFIG_VERSION=0.1.0

# ---- 完全自托管 LLM（内网 OpenAI 兼容端点）----
LLM_BACKEND=openai_compatible
LLM_BASE_URL=http://model-endpoint:8001/v1
LLM_API_KEY=<inject>
LLM_MODEL=self-hosted-model
# 端点网络白名单（受限环境必须显式；留空即 fail-closed，阻断未经批准的外联）。
LLM_ALLOWED_HOSTS=model-endpoint,10.0.0.0/8
# 脱敏日志默认开启（掩码手机号/地址/订单号/密钥/授权头）。
LLM_LOG_REDACT=true

# ---- 模型能力矩阵（写操作白名单，评测驱动）----
# 只有"通过写操作专项评测（write_op_pass=true）"的明确 model id 才能写入；其余一律拒绝写并转人工。
# 受限环境要求：显式白名单 + 提供评测报告，二者交集才生效；缺失任一 → 写操作全部 fail-closed 转人工。
# 评测产出：`scripts/evaluate_models.py --llm-backend openai_compatible --model-name <id>`
#           → evidence/llm_candidate_eval.json（关键：HIGH_CONFIDENCE_MODELS 中的 id 必须在该报告中
#             write_op_pass=true，否则运行时该项交集为空，无可写模型）。
HIGH_CONFIDENCE_MODELS=<inject-evaluated-model-id>
# 写操作评测报告路径（容器内绝对路径；docker-compose.preview.yml 已把 ./evidence/llm_candidate_eval.json
# 只读挂载到 /app/evidence/llm_candidate_eval.json）。
LLM_EVAL_REPORT_PATH=/app/evidence/llm_candidate_eval.json

# ---- 审批后执行面（受控执行开关，首次上线 shadow 沙箱）----
# execution_mode: shadow（只生成待执行记录 + 模拟回执，不触真实资金）| live（需沙箱端到端验收后）。
EXECUTION_MODE=shadow
# 外部资金/业务网关提供方。当前仅 mock（沙箱）；真实网关接入属后期替换点。live 时须为非 mock 真实提供方。
EXECUTION_PROVIDER=mock
# 回调 HMAC-SHA256 验签密钥（外部网关签名共享密钥；生产必须由环境密钥注入）。
# 禁止使用内建默认 `shadow-callback-secret`（check_secrets 会拒绝）；缺失则 api/worker 启动失败。
EXECUTION_CALLBACK_HMAC_SECRET=<inject>

# ---- 自托管可观测（可选）----
# 配置 LANGFUSE_* 后应用向自托管 Langfuse 发 trace（metadata 带 tenant_id/session_id/environment，PII 脱敏）。
# 缺省留空 → 追踪 no-op。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
