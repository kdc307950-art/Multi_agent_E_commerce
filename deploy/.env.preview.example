# deploy/.env.preview.example —— preview 环境密钥注入模板
#
# 复制为 deploy/.env.preview 并**填入真实的服务器机密**。本文件不含任何可用密钥，
# 仅列必需项与说明，让"移除演示密码、改由服务器环境密钥注入"落到可执行的注入清单上。
# deploy/.env.preview 已加入 .gitignore，不得提交。
#
# 重要：以下任一项缺省为空时，受控相关服务会启动失败（fail-closed），不会带病对外服务：
#   - POSTGRES_PASSWORD / REDIS_PASSWORD / APP_RUNTIME_PASSWORD 为空 → postgres/redis 启动即被拒。
#   - AUTH_JWT_SECRET 为空 且 ENV=preview → api 启动即 fail-closed（见 src/main.py）。
#   - APP_RUNTIME_PASSWORD 为空 → migrate 无法为 app_runtime 设置口令，api/worker 无法认证。
#
# 用法：
#   cp deploy/.env.preview.example deploy/.env.preview   # 然后逐项替换
#   docker compose --env-file deploy/.env.preview -f docker-compose.preview.yml up -d

# ---- 运行态 ----
ENV=preview
LOG_LEVEL=INFO

# ---- PostgreSQL（owner/迁移角色，具备 CREATE/ALTER/CREATEROLE）----
POSTGRES_USER=migrator
POSTGRES_PASSWORD=<inject>
POSTGRES_DB=langgraph

# ---- 运行角色（app_runtime，仅 DML，LOGIN NOINHERIT NOSUPERUSER NOBYPASSRLS）----
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=<inject>

# ---- Redis（requirepass）----
REDIS_PASSWORD=<inject>

# ---- 认证（真实 JWT，HS256；preview 必须提供，缺失则 api 启动失败）----
AUTH_JWT_SECRET=<inject>
AUTH_JWT_ISSUER=after-sales
AUTH_JWT_AUDIENCE=after-sales-web
# 固定令牌过期（秒）：签发 exp = iat + 该值；预发布建议按会话时长设定（默认 3600）。
AUTH_JWT_TTL_SECONDS=3600
# 当前签名密钥的 kid；留空则自动 = sha256(AUTH_JWT_SECRET)[:16]。
AUTH_JWT_KID=
# 密钥轮换池：上一代密钥（逗号分隔）。仅用于校验旧令牌（宽容窗口），绝不用于新签发。
# 轮换：新密钥写入 AUTH_JWT_SECRET，旧密钥追加到此处；超过 TTL 且无旧令牌校验失败后从列表移除。
AUTH_JWT_ROTATED_SECRETS=
# 登录端点凭据表（JSON）：{"<tenant_id>:<user_id>": "<sha256(credential) hex>"}（由服务器注入）。
# 用于 POST /api/auth/login 签发真实 JWT；未配置时登录 fail-closed（503）。
AUTH_LOGIN_CREDENTIALS=<inject-json>

# ---- 完全自托管 LLM（内网 OpenAI 兼容端点）----
LLM_BACKEND=openai_compatible
LLM_BASE_URL=http://model-endpoint:8001/v1
LLM_API_KEY=<inject>
LLM_MODEL=self-hosted-model
# 端点网络白名单（受限环境必须显式；留空即 fail-closed，阻断未经批准的外联）。
LLM_ALLOWED_HOSTS=model-endpoint,10.0.0.0/8
# 脱敏日志默认开启（掩码手机号/地址/订单号/密钥/授权头）。
LLM_LOG_REDACT=true

# ---- 模型能力矩阵（写操作白名单，评测驱动）----
# 只有"通过写操作专项评测（write_op_pass=true）"的明确 model id 才能写入；其余一律拒绝写并转人工。
# 受限环境要求：显式白名单 + 提供评测报告，二者交集才生效；缺失任一 → 写操作全部 fail-closed 转人工。
# 评测产出：`scripts/evaluate_models.py --llm-backend openai_compatible` → evidence/llm_candidate_eval.json
HIGH_CONFIDENCE_MODELS=<inject-evaluated-model-id>
LLM_EVAL_REPORT_PATH=/app/evidence/llm_candidate_eval.json
