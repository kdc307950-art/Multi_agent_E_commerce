# deploy/.env.production.example —— 正式生产（after-sales-prod）密钥注入模板（可提交，不含真实密钥）
#
# 复制为 deploy/.env.production（该文件已 gitignore，绝不提交真实密钥）并填入**独立生成的随机机密**。
# 要点（与 preview 完全隔离）：
#   - POSTGRES_DB 用独立库名 after_sales_prod（与 preview 的 langgraph 区分）。
#   - 所有密码/密钥用独立随机字节生成（不复用 preview 值）：openssl rand -hex 32 / openssl rand -base64 32。
#   - 独立数据卷 ./data/prod-*、独立备份目录、独立网络子网 172.31.0.0/16、独立宿主端口 8080/8843。
#
# 以下任何一项为空 / 为占位符 / 命中被禁默认值时，受控服务启动即失败（fail-closed），不会带病对外：
#   - POSTGRES_PASSWORD / REDIS_PASSWORD / APP_RUNTIME_PASSWORD 为空 → postgres/redis 启动即被拒。
#   - AUTH_JWT_SECRET 为空 且 ENV=production → api 启动即 fail-closed（src/main.py）。
#   - EXECUTION_CALLBACK_HMAC_SECRET 为空或为内建默认 'shadow-callback-secret' → check_secrets 拒绝。
#   - HIGH_CONFIDENCE_MODELS / LLM_ALLOWED_HOSTS / LAUNCH_ALLOWED_TENANTS 为空 → 写操作/端点/租户门控 fail-closed。
#   - LAUNCH_GATE_STRICT 非 true → 受限环境严格门控未开启，check_secrets 拒绝。
#
# 用法：
#   cp deploy/.env.production.example deploy/.env.production   # 然后逐项替换为随机密钥
#   docker compose --env-file deploy/.env.production -f docker-compose.prod.yml up -d

# ---- 运行态 ----
ENV=production
STORAGE_BACKEND=postgres
LOG_LEVEL=INFO
# 随部署基线递增；写入 PRODUCTION_DEPLOYMENT_record-*.md 的 DEPLOY_CONFIG_VERSION 字段。
DEPLOY_CONFIG_VERSION=0.1.0

# ---- PostgreSQL（独立库名 after_sales_prod；owner/migrator）----
POSTGRES_USER=migrator
POSTGRES_PASSWORD=<inject-random-64hex>
# 独立库名：与 preview 的 langgraph 明确区分（勿改回 langgraph，否则与 preview 数据库串扰）。
POSTGRES_DB=after_sales_prod

# ---- 运行角色（app_runtime，仅 DML）----
APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=<inject-random-64hex>

# ---- 最小权限备份角色 + 备份加密密钥 ----
BACKUP_ROLE_USER=backup_role
BACKUP_ROLE_PASSWORD=<inject-random-64hex>
BACKUP_ENC_KEY=<openssl rand -base64 32>
BACKUP_KEEP=8
BACKUP_INTERVAL_SECONDS=900
BACKUP_REMOTE_DIR=/offsite
BACKUP_RSYNC_DEST=

# ---- Redis ----
REDIS_PASSWORD=<inject-random-64hex>

# ---- 认证（真实 JWT HS256）----
AUTH_JWT_SECRET=<inject-random-96hex>
AUTH_JWT_ISSUER=after-sales-prod
AUTH_JWT_AUDIENCE=after-sales-prod-web
AUTH_JWT_TTL_SECONDS=3600
AUTH_JWT_KID=
AUTH_JWT_ROTATED_SECRETS=
# 登录凭据表（JSON）：{"<tenant_id>:<user_id>": "<PHC 哈希（argon2id|bcrypt）>"}。生产由 release-manager
# 注入首批书面确认租户成员的哈希。真实租户确认前保持空对象 {}（登录一律拒绝并审计，fail-closed）。
# 生成：python scripts/hash_login_credentials.py --algorithm argon2id
AUTH_LOGIN_CREDENTIALS={}
AUTH_CREDENTIAL_HASH=argon2id

# ---- 登录限流 ----
LOGIN_RATE_LIMIT_STORE=memory
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_ACCOUNT_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=30
LOGIN_BACKOFF_MAX_FAILURES=5
LOGIN_BACKOFF_BASE_SECONDS=1.0
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_TRUSTED_PROXY_DEPTH=1

# ---- 首批上线租户 + 严格门控 ----
LAUNCH_GATE_STRICT=true
LAUNCH_REQUIRE_APPROVAL=true
LAUNCH_FULL_AUDIT=true
LAUNCH_MANUAL_REVIEW=true
# 首批真实租户白名单（书面确认后才能放行；未确认前保持非放行占位 → 门控拒绝所有，fail-closed）。
LAUNCH_ALLOWED_TENANTS=<inject-first-confirmed-batch>

# ---- 演示/种子数据：生产一律禁止 ----
DEMO_SEED_ENABLED=false

# ---- 完全自托管 LLM（内网 OpenAI 兼容端点）。真实评测/真实端点确认前保持 mock；确认后改 openai_compatible。----
LLM_BACKEND=mock
LLM_BASE_URL=http://model-endpoint:8001/v1
LLM_API_KEY=<inject-or-mock>
LLM_MODEL=self-hosted-model
LLM_ALLOWED_HOSTS=model-endpoint,10.0.0.0/8
LLM_LOG_REDACT=true

# ---- 写操作能力矩阵（评测驱动）。无真实评测 → 交集为空 → 所有写操作 fail-closed 转人工。----
HIGH_CONFIDENCE_MODELS=<inject-evaluated-model-id-or-empty-to-fail-closed>
LLM_EVAL_REPORT_PATH=/app/evidence/llm_candidate_eval.json

# ---- 审批后执行面（首次上线 shadow 沙箱，不触真实资金）----
EXECUTION_MODE=shadow
EXECUTION_PROVIDER=mock
EXECUTION_CALLBACK_HMAC_SECRET=<inject-random-64hex>

# ---- 自托管可观测（可选）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ---- 指标内网化：白名单设为生产 internal 子网 172.31.0.0/16 ----
METRICS_EXPOSE_INTERNAL_ONLY=true
METRICS_ALLOWED_SOURCES=172.31.0.0/16
DRILL_GAUGE_STATE=/app/evidence/dr_metrics/drill_gauges.json
