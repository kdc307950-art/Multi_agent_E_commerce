# 电商售后多智能体工单系统 — 环境变量示例
# 复制为 .env 并修改。完全自托管：LLM 使用本地/内网 OpenAI 兼容端点。
#
# 预发布/生产（preview/production）机密一律由服务器环境密钥注入，本文件不承载真实密钥，
# 统一走 deploy/.env.preview（由 deploy/.env.preview.example 复制），并用
# `docker compose --env-file deploy/.env.preview -f docker-compose.preview.yml` 以受限拓扑运行。
# 受限环境 fail-closed：preview/production + AUTH_BACKEND=mock，或 + AUTH_BACKEND=real 却缺
# AUTH_JWT_SECRET，应用均启动即失败（见 deploy/PREVIEW_DEPLOYMENT_CHECKLIST.md）。

# ---- 运行包 ----
ENV=development                 # development | test | preview | production
LOG_LEVEL=INFO
API_PREFIX=/api
SESSION_TTL_DAYS=7
# 演示/种子数据：仅 development/test 且为 true 才允许 seed_default（预置演示租户/成员）；
# preview/production 必须为 false（受限环境无论本值如何都拒绝，见 src/config.py is_restricted_env）。
# DEMO_SEED_ENABLED=false
# 环境/配置版本（随部署基线递增，写进发布记录用于配置漂移审计）。
# DEPLOY_CONFIG_VERSION=0.1.0

# ---- 认证（Mock 仅在 development/test 允许；preview/production 必须 real 并 fail-closed）----
AUTH_BACKEND=mock               # mock | real。mock 只用于本地开发/单元测试。
# 真实认证后端（HS256 JWT）。生产/预发布必须 real；缺失 secret 或仍用 mock 均 fail-closed。
# 预发布/生产环境由服务器机密注入（见 deploy/.env.preview.example），此处不填真实值。
# AUTH_JWT_SECRET=<server-injected>
# JWT 固定声明（签发与校验一致；不匹配一律拒绝）。默认如下：
# AUTH_JWT_ISSUER=after-sales
# AUTH_JWT_AUDIENCE=after-sales-web
# 固定令牌过期（秒）：签发 exp = iat + 该值。默认 3600。
# AUTH_JWT_TTL_SECONDS=3600
# 当前签名密钥的 kid（JWT header 携带）；留空则自动 = sha256(AUTH_JWT_SECRET)[:16]。
# AUTH_JWT_KID=
# 密钥轮换：上一代密钥（逗号分隔）进入轮换池，仅用于校验旧令牌，绝不用于新签发。
# 轮换步骤：新密钥写入 AUTH_JWT_SECRET，旧密钥追加到此；观察无旧令牌校验失败后（超过 TTL）从列表移除。
# AUTH_JWT_ROTATED_SECRETS=
# 登录端点凭据表（JSON）：{"<tenant_id>:<user_id>": "<PHC 哈希（argon2id|bcrypt）>"}。
# 生成：python scripts/hash_login_credentials.py --algorithm argon2id|bcrypt（仅 PHC，绝不明文）。
# 用于 POST /api/auth/login 签发真实 JWT；未配置对应条目或表为空时登录 fail-closed。
# AUTH_LOGIN_CREDENTIALS={"TENANT-A:USER-001":"<argon2id PHC>"}
# 登录凭据哈希算法：argon2id（默认）| bcrypt。仅允许这两者；禁止无盐 SHA-256/md5（弱哈希）。
# AUTH_CREDENTIAL_HASH=argon2id

# ---- 登录限流与失败退避（双维度：账号 + IP）----
# 存储后端：memory（默认，单进程/无状态）| redis（分布式，需 REDIS_URL）。
# LOGIN_RATE_LIMIT_STORE=memory
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_ACCOUNT_RATE_LIMIT=5        # 单账号窗口内最大登录尝试次数
# LOGIN_IP_RATE_LIMIT=30            # 单 IP 窗口内最大登录尝试次数（跨账号聚合）
# LOGIN_BACKOFF_MAX_FAILURES=5      # 失败退避阈值
# LOGIN_BACKOFF_BASE_SECONDS=1.0
# LOGIN_BACKOFF_MAX_SECONDS=900
# LOGIN_TRUSTED_PROXY_DEPTH=1       # 受信任反向代理头来源数（nginx 之后取最后一个可信 XFF）

# ---- CORS / 统一反向代理 ----
# 生产优先"统一反向代理 + 同源 /api"；仅明确跨域时开启白名单。
ENABLE_CORS=false
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
# CORS_ALLOW_CREDENTIALS=false

# ---- 存储（本地开发默认 memory；sqlite 待实现；postgres 待 Docker/预发布验证）----
STORAGE_BACKEND=memory           # memory | sqlite | postgres
# SQLITE_PATH=./data/app.db
# 预发布/生产：运行角色连接（app_runtime），由服务器机密注入，示例仅示格式勿用真实值。
# DATABASE_URL=postgresql://<runtime-user>:<server-injected>@localhost:5432/langgraph
# 数据库迁移角色与运行角色分离（仅 preview/production 需要；本地开发可留空回退 DATABASE_URL）：
# DATABASE_MIGRATOR_URL=postgresql://<migrator>:<server-injected>@localhost:5432/langgraph
# APP_RUNTIME_USER=app_runtime
# APP_RUNTIME_PASSWORD=<server-injected>
# DATABASE_MIGRATE_ON_STARTUP=false          # preview/production 必须为 false；运行角色不做 DDL

# ---- LLM（本地/内网 OpenAI 兼容端点，完全自托管）----
LLM_BACKEND=mock                 # mock | openai_compatible
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=<server-injected>    # 预发布/生产由服务器机密注入，勿用演示密钥
LLM_MODEL=self-hosted-model
# LLM_TIMEOUT_SECONDS=10          # 单次调用总期限（deadline）
# LLM_MAX_RETRIES=2               # 同类型错误有界重试
# 端点网络白名单（逗号分隔 host / IP / CIDR）。完全自托管：端点必须落在受控内网/私网。
# 非受限环境为空时默认仅放行 loopback + RFC1918 私网（禁止公网 SaaS）；受限环境为空则 fail-closed。
# LLM_ALLOWED_HOSTS=model-endpoint,10.0.0.0/8
# 脱敏日志：掩码手机号/地址/订单号/密钥/授权头（默认开启）。
# LLM_LOG_REDACT=true

# ---- 模型能力矩阵（写操作白名单，评测驱动）----
# 只有"通过写操作专项评测（write_op_pass=true）"的明确 model id 才能进入；其余一律拒绝写并转人工。
# 生产/受限环境要求：显式白名单 + 提供评测报告（llm_eval_report_path），二者交集才生效，否则 fail-closed。
# 评测产出见 `scripts/evaluate_models.py` → evidence/llm_candidate_eval.json。
# HIGH_CONFIDENCE_MODELS=qwen2.5-max,self-hosted-model
# LLM_EVAL_REPORT_PATH=evidence/llm_candidate_eval.json

# ---- 意图 / 模型输出校验（严格）----
# 低于该置信度的意图 fail-closed 转人工；打开即对结构化输出做严格 schema 校验。
INTENT_CONFIDENCE_THRESHOLD=0.7
STRICT_MODEL_OUTPUT=true

# ---- 自托管检索组件 ----
# keyword（缺省，确定性无外依赖） | milvus（可选，自托管 Milvus Lite，需安装 pymilvus）
RETRIEVAL_BACKEND=keyword
RETRIEVAL_TOP_K=4
# MILVUS_URI=./data/milvus_local.db
# MILVUS_DB_NAME=after_sales
# MILVUS_COLLECTION=policy
# MILVUS_EMBEDDING_DIM=128

# ---- 业务规则 / 资格窗口 ----
REFUND_ELIGIBILITY_DAYS=7
RETURN_ELIGIBILITY_DAYS=30
# APPROVAL_TIMEOUT_SECONDS=3600   # 审批超时后转人工（保留 operation_id）

# ---- CrewAI / MCP 子智能体集成（默认关闭，走内置确定性路径）----
# 打开后需提供真实调用链（本地模型端点）并通过集成测试；未验证不得在生产开启。
CREWAI_ENABLED=false
# CREWAI_MODEL=
# CREWAI_ALLOW_DELEGATION=true

# ---- 队列 / 锁（Celery + Redis；本机未装 Redis 时跳过）----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ---- 可观测（自托管 Langfuse；未配置则不启用）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002

# ---- 长期记忆（仅验收闸门通过后启用；完全自托管必须关闭匿名遥测）----
# GRAPHITI_TELEMETRY_ENABLED=false
